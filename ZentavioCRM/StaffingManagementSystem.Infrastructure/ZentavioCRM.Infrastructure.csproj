<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StaffingManagementSystem.Core\ZentavioCRM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Extensions\" />
    <Folder Include="Persistence\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read at runtime by TenantProvisioningService to build each new tenant's database.
         Physically these files live in the solution-level "SQL Changes" folder alongside every
         other SQL script (see SQL Changes/001_CreateSchema.sql's header comment) — only these
         two specific files are embedded into this assembly; the Link keeps them showing under
         Persistence/Scripts in Solution Explorer and preserves the embedded resource name that
         TenantProvisioningService.ReadEmbeddedSql looks up by filename suffix. -->
    <EmbeddedResource Include="..\SQL Changes\TenantSchema.sql" Link="Persistence\Scripts\TenantSchema.sql" />
    <EmbeddedResource Include="..\SQL Changes\TenantRbacSeed.sql" Link="Persistence\Scripts\TenantRbacSeed.sql" />
  </ItemGroup>

</Project>
