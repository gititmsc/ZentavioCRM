<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StaffingManagementSystem.Core\ZentavioCRM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Extensions\" />
    <Folder Include="Persistence\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read at runtime by TenantProvisioningService to build each new tenant's database.
         Physically these files live in the solution-level "SQL Changes/Tenant" folder alongside
         every other per-tenant-database script (see SQL Changes/Tenant/001_CreateSchema.sql's
         header comment) — only these two specific files are embedded into this assembly; the
         Link keeps them showing under Persistence/Scripts in Solution Explorer and preserves the
         embedded resource name that TenantProvisioningService.ReadEmbeddedSql looks up by
         filename suffix. They're deliberately left unnumbered in that folder — unlike the other
         scripts there, they're not guarded/idempotent (built to run once against a brand-new,
         guaranteed-empty database) and aren't meant to be run manually as part of that numbered
         sequence. -->
    <EmbeddedResource Include="..\SQL Changes\Tenant\TenantSchema.sql" Link="Persistence\Scripts\TenantSchema.sql" />
    <EmbeddedResource Include="..\SQL Changes\Tenant\TenantRbacSeed.sql" Link="Persistence\Scripts\TenantRbacSeed.sql" />
  </ItemGroup>

</Project>
